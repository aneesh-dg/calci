pipeline {
    agent {
        docker {
            image 'python:3.12-slim'
        }
    }

    stages {
        stage('Test') {
            steps {
                sh 'python -m unittest discover -v'
            }
        }

        stage('Build Package') {
            steps {
                sh 'tar -czf calculator-package.tar.gz calculator.py'
                archiveArtifacts artifacts: 'calculator-package.tar.gz', fingerprint: true
            }
        }
    }
}